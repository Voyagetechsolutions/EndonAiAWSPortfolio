{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "endon-siem",
          "version": "0.1.0",
          "informationUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
          "rules": [
            {
              "id": "SIEM-001",
              "name": "DetectionCloudtrailSiem001",
              "shortDescription": {
                "text": "Root account activity"
              },
              "fullDescription": {
                "text": "Root account activity \u2014 ConsoleLogin by root:123456789012 (ATT&CK T1078.004)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "detection",
                  "Incident Response"
                ]
              },
              "help": {
                "text": "Root should never be used for API calls; investigate and rotate root credentials."
              }
            },
            {
              "id": "SIEM-005",
              "name": "DetectionCloudtrailSiem005",
              "shortDescription": {
                "text": "Administrator policy attached"
              },
              "fullDescription": {
                "text": "Administrator policy attached \u2014 AttachUserPolicy by arn:aws:iam::123456789012:user/mallory (ATT&CK T1098)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "detection",
                  "Identity and Access Management"
                ]
              },
              "help": {
                "text": "Confirm the grant; attaching AdministratorAccess is a common escalation step."
              }
            },
            {
              "id": "SIEM-002",
              "name": "DetectionCloudtrailSiem002",
              "shortDescription": {
                "text": "CloudTrail logging tampered"
              },
              "fullDescription": {
                "text": "CloudTrail logging tampered \u2014 StopLogging by arn:aws:iam::123456789012:user/mallory (ATT&CK T1562.008)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "detection",
                  "Detection"
                ]
              },
              "help": {
                "text": "Re-enable the trail and alert; log tampering precedes most attacks."
              }
            },
            {
              "id": "SIEM-003",
              "name": "DetectionCloudtrailSiem003",
              "shortDescription": {
                "text": "Detective service disabled"
              },
              "fullDescription": {
                "text": "Detective service disabled \u2014 DeleteDetector by arn:aws:iam::123456789012:user/mallory (ATT&CK T1562.001)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "detection",
                  "Detection"
                ]
              },
              "help": {
                "text": "Re-enable GuardDuty/Config/Security Hub and investigate who disabled it."
              }
            },
            {
              "id": "SIEM-006",
              "name": "DetectionCloudtrailSiem006",
              "shortDescription": {
                "text": "S3 bucket made public"
              },
              "fullDescription": {
                "text": "S3 bucket made public \u2014 PutBucketAcl by arn:aws:iam::123456789012:user/mallory (ATT&CK T1530)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "detection",
                  "Data Protection"
                ]
              },
              "help": {
                "text": "Re-enable Block Public Access; a public bucket is a data-exposure path."
              }
            },
            {
              "id": "SIEM-104",
              "name": "DetectionCloudtrailSiem104",
              "shortDescription": {
                "text": "Credentials used from multiple IPs"
              },
              "fullDescription": {
                "text": "Credentials used from multiple IPs \u2014 15 events for arn:aws:iam::123456789012:user/mallory within the window (ATT&CK T1078)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "detection",
                  "Incident Response"
                ]
              },
              "help": {
                "text": "The same credentials from two IPs in a short window suggests theft; revoke and rotate."
              }
            },
            {
              "id": "SIEM-101",
              "name": "DetectionCloudtrailSiem101",
              "shortDescription": {
                "text": "Mass S3 download (possible exfiltration)"
              },
              "fullDescription": {
                "text": "Mass S3 download (possible exfiltration) \u2014 5 events for arn:aws:iam::123456789012:user/mallory within the window (ATT&CK T1530)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "detection",
                  "Data Protection"
                ]
              },
              "help": {
                "text": "Investigate the principal; a burst of GetObject is exfiltration until proven otherwise."
              }
            },
            {
              "id": "SIEM-102",
              "name": "DetectionCloudtrailSiem102",
              "shortDescription": {
                "text": "Console login brute force"
              },
              "fullDescription": {
                "text": "Console login brute force \u2014 4 events for arn:aws:iam::123456789012:user/admin within the window (ATT&CK T1110)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "detection",
                  "Incident Response"
                ]
              },
              "help": {
                "text": "Lock the account and require MFA; repeated failed logins are a brute-force attempt."
              }
            },
            {
              "id": "SIEM-103",
              "name": "DetectionCloudtrailSiem103",
              "shortDescription": {
                "text": "Reconnaissance burst"
              },
              "fullDescription": {
                "text": "Reconnaissance burst \u2014 8 events for arn:aws:iam::123456789012:user/mallory within the window (ATT&CK T1580)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "detection",
                  "Detection"
                ]
              },
              "help": {
                "text": "A scan of Describe/List calls maps the account; correlate with the principal's other activity."
              }
            },
            {
              "id": "SIEM-004",
              "name": "DetectionCloudtrailSiem004",
              "shortDescription": {
                "text": "New access key created"
              },
              "fullDescription": {
                "text": "New access key created \u2014 CreateAccessKey by arn:aws:iam::123456789012:user/mallory (ATT&CK T1098.001)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "detection",
                  "Identity and Access Management"
                ]
              },
              "help": {
                "text": "Confirm the key was expected; attackers create keys for persistence."
              }
            },
            {
              "id": "SIEM-007",
              "name": "DetectionCloudtrailSiem007",
              "shortDescription": {
                "text": "Security group opened to the internet"
              },
              "fullDescription": {
                "text": "Security group opened to the internet \u2014 AuthorizeSecurityGroupIngress by arn:aws:iam::123456789012:user/mallory (ATT&CK T1562.007)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "detection",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Scope the ingress rule; 0.0.0.0/0 is an entry point."
              }
            }
          ]
        }
      },
