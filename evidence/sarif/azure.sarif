{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "endon-azure",
          "version": "0.1.0",
          "informationUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
          "rules": [
            {
              "id": "AZ-STG-001",
              "name": "AzurepostureStorageBlobpublicaccess",
              "shortDescription": {
                "text": "Storage account allows public blob access"
              },
              "fullDescription": {
                "text": "Storage account allows public blob access (acmepublic)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "azureposture",
                  "Data Protection"
                ]
              },
              "help": {
                "text": "Set allowBlobPublicAccess = false on the storage account."
              }
            },
            {
              "id": "AZ-DISK-001",
              "name": "AzurepostureComputeDisknotencrypted",
              "shortDescription": {
                "text": "Managed disk is not encrypted"
              },
              "fullDescription": {
                "text": "Managed disk is not encrypted (acme-data)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "azureposture",
                  "Data Protection"
                ]
              },
              "help": {
                "text": "Enable encryption at rest (platform-managed or customer-managed key)."
              }
            },
            {
              "id": "AZ-KV-001",
              "name": "AzurepostureKeyvaultNopurgeprotection",
              "shortDescription": {
                "text": "Key Vault does not have purge protection"
              },
              "fullDescription": {
                "text": "Key Vault does not have purge protection (acme-kv)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "azureposture",
                  "Data Protection"
                ]
              },
              "help": {
                "text": "Enable enablePurgeProtection so keys/secrets cannot be permanently deleted early."
              }
            },
            {
              "id": "AZ-NSG-001",
              "name": "AzurepostureNetworkAdminportfrominternet",
              "shortDescription": {
                "text": "NSG allows SSH/RDP inbound from the Internet"
              },
              "fullDescription": {
                "text": "NSG allows SSH/RDP inbound from the Internet (acme-nsg)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "azureposture",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Remove Internet-sourced inbound rules on 22/3389; use a bastion or JIT access."
              }
            },
            {
              "id": "AZ-STG-002",
              "name": "AzurepostureStorageHttpallowed",
              "shortDescription": {
                "text": "Storage account allows unencrypted HTTP"
              },
              "fullDescription": {
                "text": "Storage account allows unencrypted HTTP (acmepublic)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "azureposture",
                  "Data Protection"
                ]
              },
              "help": {
                "text": "Set supportsHttpsTrafficOnly = true."
              }
            },
            {
              "id": "AZ-DEF-001",
              "name": "AzurepostureDefenderDefenderplanfree",
              "shortDescription": {
                "text": "Microsoft Defender for Cloud plan is not enabled"
              },
              "fullDescription": {
                "text": "Microsoft Defender for Cloud plan is not enabled (StorageAccounts)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "azureposture",
                  "Detection"
                ]
              },
              "help": {
                "text": "Set the Defender pricing tier to Standard for this resource type."
              }
            },
            {
              "id": "AZ-KV-002",
              "name": "AzurepostureKeyvaultPublicnetworkaccess",
              "shortDescription": {
                "text": "Key Vault is reachable from public networks"
              },
              "fullDescription": {
                "text": "Key Vault is reachable from public networks (acme-kv)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "azureposture",
                  "Data Protection"
                ]
              },
              "help": {
                "text": "Set publicNetworkAccess = Disabled and use private endpoints."
              }
            },
            {
              "id": "AZ-NSG-002",
              "name": "AzurepostureNetworkOpeningress",
              "shortDescription": {
                "text": "NSG allows inbound from the Internet"
              },
              "fullDescription": {
                "text": "NSG allows inbound from the Internet (acme-nsg)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "azureposture",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Scope inbound rules to known source prefixes."
              }
            },
            {
              "id": "AZ-STG-003",
              "name": "AzurepostureStorageOpennetworkaccess",
              "shortDescription": {
                "text": "Storage account is reachable from all networks"
              },
              "fullDescription": {
                "text": "Storage account is reachable from all networks (acmepublic)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "azureposture",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Set networkAcls.defaultAction = Deny and allow only known VNets/IPs."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "AZ-STG-001",
          "level": "error",
          "message": {
            "text": "Storage account allows public blob access (acmepublic)."
          },
          "partialFingerprints": {
            "endonFindingId/v1": "2d2ba73bad42074ec1b03fb66ad2ddce"
          },
          "properties": {
            "severity": "CRITICAL",
            "endon/type": "AzurePosture:Storage/BlobPublicAccess"
          },
          "locations": [
