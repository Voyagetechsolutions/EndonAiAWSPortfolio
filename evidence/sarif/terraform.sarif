{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "endon-tfscan",
          "version": "0.1.0",
          "informationUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
          "rules": [
            {
              "id": "TF-IAM-001",
              "name": "IacIamAdministratorpolicy",
              "shortDescription": {
                "text": "IAM policy grants administrator-equivalent access"
              },
              "fullDescription": {
                "text": "IAM policy grants administrator-equivalent access (aws_iam_policy.admin) \u2014 flagged in the Terraform plan before apply."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "iac",
                  "Identity and Access Management"
                ]
              },
              "help": {
                "text": "Replace Action \"*\" on Resource \"*\" with the specific actions the workload needs."
              }
            },
            {
              "id": "TF-RDS-002",
              "name": "IacRdsInstancepubliclyaccessible",
              "shortDescription": {
                "text": "RDS instance is publicly accessible"
              },
              "fullDescription": {
                "text": "RDS instance is publicly accessible (aws_db_instance.db) \u2014 flagged in the Terraform plan before apply."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "iac",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Set publicly_accessible = false and place the instance in private subnets."
              }
            },
            {
              "id": "TF-S3-001",
              "name": "IacS3Bucketpubliclyaccessible",
              "shortDescription": {
                "text": "S3 bucket is exposed publicly"
              },
              "fullDescription": {
                "text": "S3 bucket is exposed publicly (aws_s3_bucket.public) \u2014 flagged in the Terraform plan before apply."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "iac",
                  "Data Protection"
                ]
              },
              "help": {
                "text": "Set the ACL to private and enable a Block Public Access block with all four flags true."
              }
            },
            {
              "id": "TF-LOG-001",
              "name": "IacCloudtrailTrailnothardened",
              "shortDescription": {
                "text": "CloudTrail is single-region or unencrypted"
              },
              "fullDescription": {
                "text": "CloudTrail is single-region or unencrypted (aws_cloudtrail.trail) \u2014 flagged in the Terraform plan before apply."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "iac",
                  "Detection"
                ]
              },
              "help": {
                "text": "Set is_multi_region_trail = true and a kms_key_id so the audit log is complete and encrypted."
              }
            },
            {
              "id": "TF-EBS-001",
              "name": "IacEbsVolumenotencrypted",
              "shortDescription": {
                "text": "EBS volume is not encrypted at rest"
              },
              "fullDescription": {
                "text": "EBS volume is not encrypted at rest (aws_ebs_volume.data) \u2014 flagged in the Terraform plan before apply."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "iac",
                  "Data Protection"
                ]
              },
              "help": {
                "text": "Set encrypted = true (ideally with a customer-managed KMS key)."
              }
            },
            {
              "id": "TF-EC2-001",
              "name": "IacEc2Unrestrictedadminport",
              "shortDescription": {
                "text": "Security group opens SSH/RDP to the internet"
              },
              "fullDescription": {
                "text": "Security group opens SSH/RDP to the internet (aws_security_group.open) \u2014 flagged in the Terraform plan before apply."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "iac",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Restrict ingress on 22/3389 to known CIDRs or a bastion, never 0.0.0.0/0."
              }
            },
            {
              "id": "TF-IAM-002",
              "name": "IacIamUnscopedpassrole",
              "shortDescription": {
                "text": "IAM policy allows iam:PassRole on any role"
              },
              "fullDescription": {
                "text": "IAM policy allows iam:PassRole on any role (aws_iam_policy.admin) \u2014 flagged in the Terraform plan before apply."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "iac",
                  "Identity and Access Management"
                ]
              },
              "help": {
                "text": "Scope iam:PassRole to specific role ARNs; a wildcard is a privilege-escalation path."
              }
            },
            {
              "id": "TF-RDS-001",
              "name": "IacRdsInstancenotencrypted",
              "shortDescription": {
                "text": "RDS instance storage is not encrypted"
              },
              "fullDescription": {
                "text": "RDS instance storage is not encrypted (aws_db_instance.db) \u2014 flagged in the Terraform plan before apply."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "iac",
                  "Data Protection"
                ]
              },
              "help": {
                "text": "Set storage_encrypted = true with a KMS key."
              }
            },
            {
              "id": "TF-S3-002",
              "name": "IacS3Bucketencryptiondisabled",
              "shortDescription": {
                "text": "S3 bucket has no server-side encryption"
              },
              "fullDescription": {
                "text": "S3 bucket has no server-side encryption (aws_s3_bucket.public) \u2014 flagged in the Terraform plan before apply."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "iac",
                  "Data Protection"
                ]
              },
              "help": {
                "text": "Add a server_side_encryption_configuration (aws:kms or AES256)."
              }
            },
            {
              "id": "TF-EC2-003",
              "name": "IacEc2Imdsv2Notenforced",
              "shortDescription": {
                "text": "EC2 instance does not enforce IMDSv2"
              },
              "fullDescription": {
                "text": "EC2 instance does not enforce IMDSv2 (aws_instance.legacy) \u2014 flagged in the Terraform plan before apply."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "iac",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Set metadata_options.http_tokens = \"required\" to block SSRF credential theft."
              }
            },
            {
              "id": "TF-EC2-002",
              "name": "IacEc2Unrestrictedingress",
              "shortDescription": {
                "text": "Security group allows ingress from 0.0.0.0/0"
              },
              "fullDescription": {
                "text": "Security group allows ingress from 0.0.0.0/0 (aws_security_group.open) \u2014 flagged in the Terraform plan before apply."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "iac",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Scope ingress CIDRs to what actually needs access."
              }
            },
            {
              "id": "TF-KMS-001",
              "name": "IacKmsKeyrotationdisabled",
              "shortDescription": {
                "text": "KMS key does not have rotation enabled"
              },
              "fullDescription": {
                "text": "KMS key does not have rotation enabled (aws_kms_key.key) \u2014 flagged in the Terraform plan before apply."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "iac",
                  "Data Protection"
                ]
              },
              "help": {
                "text": "Set enable_key_rotation = true on customer-managed keys."
              }
            },
            {
              "id": "TF-S3-003",
              "name": "IacS3Bucketversioningdisabled",
              "shortDescription": {
                "text": "S3 bucket versioning is disabled"
              },
              "fullDescription": {
                "text": "S3 bucket versioning is disabled (aws_s3_bucket.public) \u2014 flagged in the Terraform plan before apply."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "iac",
                  "Data Protection"
                ]
              },
              "help": {
                "text": "Enable versioning so objects can be recovered after deletion or overwrite."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "TF-IAM-001",
          "level": "error",
          "message": {
            "text": "IAM policy grants administrator-equivalent access (aws_iam_policy.admin) \u2014 flagged in the Terraform plan before apply."
          },
          "partialFingerprints": {
            "endonFindingId/v1": "45f498ec97e8ed4a9d9f79330869a9c0"
          },
          "properties": {
            "severity": "CRITICAL",
            "endon/type": "IaC:IAM/AdministratorPolicy"
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "aws_iam_policy.admin",
                  "name": "aws_iam_policy.admin",
                  "kind": "TerraformResource"
                }
