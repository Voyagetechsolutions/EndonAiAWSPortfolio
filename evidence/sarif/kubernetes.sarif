{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "endon-k8s",
          "version": "0.1.0",
          "informationUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
          "rules": [
            {
              "id": "K8S-POD-001",
              "name": "K8SPodPrivilegedcontainer",
              "shortDescription": {
                "text": "Container runs privileged"
              },
              "fullDescription": {
                "text": "Container runs privileged (Deployment/default/legacy-api)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "k8s",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Remove securityContext.privileged; grant only the capabilities needed."
              }
            },
            {
              "id": "K8S-RBAC-005",
              "name": "K8SRbacClusteradminbinding",
              "shortDescription": {
                "text": "Binding grants cluster-admin"
              },
              "fullDescription": {
                "text": "Binding grants cluster-admin (ClusterRoleBinding/default/give-everyone-admin)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "k8s",
                  "Identity and Access Management"
                ]
              },
              "help": {
                "text": "Bind a least-privilege role instead of cluster-admin."
              }
            },
            {
              "id": "K8S-RBAC-004",
              "name": "K8SRbacRbacescalation",
              "shortDescription": {
                "text": "Role can bind or escalate RBAC"
              },
              "fullDescription": {
                "text": "Role can bind or escalate RBAC (ClusterRole/default/rbac-escalator)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "k8s",
                  "Identity and Access Management"
                ]
              },
              "help": {
                "text": "Remove bind/escalate on roles/clusterroles; it lets a subject grant itself more."
              }
            },
            {
              "id": "K8S-RBAC-001",
              "name": "K8SRbacWildcardpermission",
              "shortDescription": {
                "text": "Role grants wildcard verbs on wildcard resources"
              },
              "fullDescription": {
                "text": "Role grants wildcard verbs on wildcard resources (ClusterRole/default/god-mode)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "k8s",
                  "Identity and Access Management"
                ]
              },
              "help": {
                "text": "Replace '*' with the specific verbs and resources the workload needs."
              }
            },
            {
              "id": "K8S-POD-002",
              "name": "K8SPodAllowsprivilegeescalation",
              "shortDescription": {
                "text": "Container allows privilege escalation"
              },
              "fullDescription": {
                "text": "Container allows privilege escalation (Deployment/default/legacy-api)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "k8s",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Set securityContext.allowPrivilegeEscalation = false."
              }
            },
            {
              "id": "K8S-POD-007",
              "name": "K8SPodDangerouscapabilities",
              "shortDescription": {
                "text": "Container adds dangerous Linux capabilities"
              },
              "fullDescription": {
                "text": "Container adds dangerous Linux capabilities (Deployment/default/legacy-api)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "k8s",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Drop ALL capabilities and add back only what is required."
              }
            },
            {
              "id": "K8S-POD-005",
              "name": "K8SPodHostnamespace",
              "shortDescription": {
                "text": "Pod shares a host namespace"
              },
              "fullDescription": {
                "text": "Pod shares a host namespace (Deployment/default/legacy-api)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "k8s",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Set hostNetwork/hostPID/hostIPC to false."
              }
            },
            {
              "id": "K8S-POD-004",
              "name": "K8SPodHostpathvolume",
              "shortDescription": {
                "text": "Pod mounts a hostPath volume"
              },
              "fullDescription": {
                "text": "Pod mounts a hostPath volume (Deployment/default/legacy-api)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "k8s",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Remove hostPath mounts; use a proper volume type."
              }
            },
            {
              "id": "K8S-POD-011",
              "name": "K8SPodHostportexposed",
              "shortDescription": {
                "text": "Container binds a host port"
              },
              "fullDescription": {
                "text": "Container binds a host port (Deployment/default/legacy-api)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "k8s",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Remove hostPort; expose the pod through a Service instead."
              }
            },
            {
              "id": "K8S-POD-003",
              "name": "K8SPodRunsasroot",
              "shortDescription": {
                "text": "Container may run as root"
              },
              "fullDescription": {
                "text": "Container may run as root (Deployment/default/legacy-api)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "k8s",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Set runAsNonRoot = true (and a non-zero runAsUser)."
              }
            },
            {
              "id": "K8S-RBAC-002",
              "name": "K8SRbacClustersecretsaccess",
              "shortDescription": {
                "text": "Role can read Secrets"
              },
              "fullDescription": {
                "text": "Role can read Secrets (ClusterRole/default/god-mode)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "k8s",
                  "Identity and Access Management"
                ]
              },
              "help": {
                "text": "Scope secret access to a namespace and specific secret names."
              }
            },
            {
              "id": "K8S-RBAC-003",
              "name": "K8SRbacPodcreate",
              "shortDescription": {
                "text": "Role can create Pods"
              },
              "fullDescription": {
                "text": "Role can create Pods (ClusterRole/default/god-mode)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "k8s",
                  "Identity and Access Management"
                ]
              },
              "help": {
                "text": "Pod creation allows running privileged/host-mounting pods; grant only where needed."
              }
            },
            {
              "id": "K8S-RBAC-006",
              "name": "K8SRbacPodexec",
              "shortDescription": {
                "text": "Role can exec into Pods"
              },
              "fullDescription": {
                "text": "Role can exec into Pods (Role/default/debugger)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "k8s",
                  "Identity and Access Management"
                ]
              },
              "help": {
                "text": "pods/exec and pods/attach give shell access to running containers; restrict it."
              }
            },
            {
              "id": "K8S-POD-009",
              "name": "K8SPodMutableimagetag",
              "shortDescription": {
                "text": "Container image is not pinned"
              },
              "fullDescription": {
                "text": "Container image is not pinned (Deployment/default/legacy-api)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "k8s",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Pin the image by digest (@sha256:...) instead of :latest or a floating tag."
              }
            },
            {
              "id": "K8S-POD-006",
              "name": "K8SPodNoresourcelimits",
              "shortDescription": {
                "text": "Container has no CPU/memory limits"
              },
              "fullDescription": {
                "text": "Container has no CPU/memory limits (Deployment/default/legacy-api)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "k8s",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Set resources.limits for cpu and memory to bound a compromised container."
              }
            },
            {
              "id": "K8S-POD-010",
              "name": "K8SPodServiceaccounttokenmounted",
              "shortDescription": {
                "text": "Service-account token is auto-mounted"
              },
              "fullDescription": {
                "text": "Service-account token is auto-mounted (Deployment/default/legacy-api)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "k8s",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Set automountServiceAccountToken = false unless the pod calls the API."
              }
            },
            {
              "id": "K8S-POD-008",
              "name": "K8SPodWritablerootfilesystem",
              "shortDescription": {
                "text": "Container root filesystem is writable"
              },
              "fullDescription": {
                "text": "Container root filesystem is writable (Deployment/default/legacy-api)."
              },
              "helpUri": "https://github.com/Voyagetechsolutions/EndonAiAWSPortfolio",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "k8s",
                  "Infrastructure Security"
                ]
              },
              "help": {
                "text": "Set readOnlyRootFilesystem = true."
              }
            }
          ]
        }
      },
